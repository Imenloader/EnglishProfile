;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/ghc.jpg\" alt=\"GHC\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/etisalat.jpg\" alt=\"Etisalat International\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/alameda.jpg\" alt=\"Alameda\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/sonesta.jpg\" alt=\"Sonesta\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/suez.jpg\" alt=\"Suez\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/alazhar.jpg\" alt=\"Al-Azhar Graduates\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/tamayyoz.jpg\" alt=\"Tamayyoz\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div><div class=\"glass-card\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;width:220px;height:140px;padding:1.5rem;border-radius:20px;flex-shrink:0;transition:all 0.4s ease;background:var(--card-bg);border:1px solid var(--border-color);overflow:hidden\"><img src=\"/images/partners/ghc.jpg\" alt=\"GHC\" style=\"max-width:100%;max-height:100%;object-fit:contain\"/></div></div></div></div></section><section id=\"about\" style=\"padding:10rem 0;background:var(--bg-color)\"><div class=\"container\"><div class=\"grid-responsive\" style=\"gap:clamp(3rem, 10vw, 8rem);align-items:center\"><div data-aos=\"fade-up\"><span class=\"gold-text\" style=\"letter-spacing:4px;font-size:0.8rem;font-weight:700;margin-bottom:2rem;display:block\">ABOUT</span><h2 style=\"font-size:clamp(2.5rem, 5vw, 4rem);line-height:1.1;margin-bottom:3rem;color:var(--text-color)\">Language <br/> learning, <br/> <span class=\"gold-text\">reimagined</span></h2><p style=\"font-size:1.2rem;line-height:1.8;color:var(--text-color-muted);margin-bottom:4rem;max-width:600px\">Linguaplanet was born from a simple belief: every Egyptian deserves access to world-class English education. We blend ground-breaking pedagogy with genuine care for our students&#x27; futures.</p><div style=\"display:grid;gap:2.5rem\"><div style=\"display:flex;gap:1.5rem;align-items:flex-start\" data-aos=\"fade-up\" data-aos-delay=\"0\"><div style=\"width:48px;height:48px;background:rgba(197, 160, 89, 0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0\"><i class=\"fa-solid fa-star\" style=\"color:var(--accent-gold);font-size:1.2rem\"></i></div><div><h4 style=\"font-size:1.15rem;font-weight:700;color:var(--text-color);margin-bottom:0.5rem\">Excellent Services</h4><p style=\"font-size:0.95rem;opacity:0.7;line-height:1.6\">We provide excellent language services at affordable prices.</p></div></div><div style=\"display:flex;gap:1.5rem;align-items:flex-start\" data-aos=\"fade-up\" data-aos-delay=\"100\"><div style=\"width:48px;height:48px;background:rgba(197, 160, 89, 0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0\"><i class=\"fa-solid fa-tags\" style=\"color:var(--accent-gold);font-size:1.2rem\"></i></div><div><h4 style=\"font-size:1.15rem;font-weight:700;color:var(--text-color);margin-bottom:0.5rem\">Affordable Pricing</h4><p style=\"font-size:0.95rem;opacity:0.7;line-height:1.6\">We provide not only flexible price plans, but flexible modes of delivery as well.</p></div></div><div style=\"display:flex;gap:1.5rem;align-items:flex-start\" data-aos=\"fade-up\" data-aos-delay=\"200\"><div style=\"width:48px;height:48px;background:rgba(197, 160, 89, 0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0\"><i class=\"fa-solid fa-lightbulb\" style=\"color:var(--accent-gold);font-size:1.2rem\"></i></div><div><h4 style=\"font-size:1.15rem;font-weight:700;color:var(--text-color);margin-bottom:0.5rem\">Ground-breaking Approaches</h4><p style=\"font-size:0.95rem;opacity:0.7;line-height:1.6\">We use ground-breaking, top-notch approaches in language teaching.</p></div></div></div></div><div style=\"position:relative\" data-aos=\"zoom-in\"><div style=\"border-radius:40px;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,0.1)\"><img alt=\"\" loading=\"lazy\" width=\"600\" height=\"800\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;width:100%;height:auto;display:block\" src=\"/images/about-vision.png\"/></div><div style=\"position:absolute;top:30px;right:-30px;left:auto;width:100%;height:100%;border:2px solid var(--accent-gold);border-radius:40px;z-index:-1\"></div></div></div></div></section><section id=\"values\" style=\"padding:10rem 0;background:var(--bg-color-alt);position:relative;overflow:hidden\"><div class=\"container\"><div class=\"text-center\" style=\"margin-bottom:6rem\" data-aos=\"fade-up\"><span style=\"color:var(--accent-gold);font-size:0.8rem;font-weight:800;letter-spacing:5px;text-transform:uppercase\">Our values</span><h2 style=\"font-size:clamp(2.5rem, 5vw, 4rem);margin-top:1.5rem;color:var(--text-color);font-family:var(--font-serif)\">What drives us forward</h2></div><div class=\"grid-responsive\" style=\"gap:2rem\"><div class=\"glass-card\" style=\"padding:4rem;border-radius:32px;text-align:center\" data-aos=\"fade-up\" data-aos-delay=\"0\"><div style=\"font-size:3rem;color:var(--accent-gold);margin-bottom:2rem\"><i class=\"fa-solid fa-award\"></i></div><h3 style=\"color:var(--text-color);font-size:1.8rem;margin-bottom:1.5rem\">Quality</h3><p style=\"color:var(--text-color-muted);font-size:1.1rem\">We strive to provide excellence.</p></div><div class=\"glass-card\" style=\"padding:4rem;border-radius:32px;text-align:center\" data-aos=\"fade-up\" data-aos-delay=\"100\"><div style=\"font-size:3rem;color:var(--accent-gold);margin-bottom:2rem\"><i class=\"fa-solid fa-arrows-spin\"></i></div><h3 style=\"color:var(--text-color);font-size:1.8rem;margin-bottom:1.5rem\">Flexibility</h3><p style=\"color:var(--text-color-muted);font-size:1.1rem\">We provide a variety of options and solutions.</p></div><div class=\"glass-card\" style=\"padding:4rem;border-radius:32px;text-align:center\" data-aos=\"fade-up\" data-aos-delay=\"200\"><div style=\"font-size:3rem;color:var(--accent-gold);margin-bottom:2rem\"><i class=\"fa-solid fa-handshake-angle\"></i></div><h3 style=\"color:var(--text-color);font-size:1.8rem;margin-bottom:1.5rem\">Social Responsibility</h3><p style=\"color:var(--text-color-muted);font-size:1.1rem\">We believe in giving back to the community.</p></div></div><div class=\"grid-2-col\" style=\"margin-top:6rem;gap:3rem\"><div class=\"glass-card\" style=\"padding:4.5rem;border-radius:40px\" data-aos=\"fade-right\"><span style=\"color:var(--accent-gold);font-size:0.7rem;font-weight:800;letter-spacing:3px\">OUR VISION</span><h3 style=\"color:var(--text-color);font-size:2.5rem;margin:1.5rem 0\">Achieve Effortlessly</h3><p style=\"color:var(--text-color-muted);font-size:1.2rem;line-height:1.8\">Provide opportunities for language learners to unlock their full potential and achieve their goals effortlessly.</p></div><div class=\"glass-card\" style=\"padding:4.5rem;border-radius:40px\" data-aos=\"fade-left\"><span style=\"color:var(--accent-gold);font-size:0.7rem;font-weight:800;letter-spacing:3px\">OUR MISSION</span><h3 style=\"color:var(--text-color);font-size:2.5rem;margin:1.5rem 0\">Lead and Support</h3><p style=\"color:var(--text-color-muted);font-size:1.2rem;line-height:1.8\">Support and lead the English learning community in Egypt through innovation and excellence.</p></div></div></div></section><section id=\"why-us\" style=\"padding:10rem 0;background:var(--bg-color)\"><div class=\"container\"><div class=\"text-center\" style=\"margin-bottom:6rem\" data-aos=\"fade-up\"><span style=\"color:var(--accent-gold);font-size:0.8rem;font-weight:800;letter-spacing:5px;text-transform:uppercase\">Why choose us:</span><h2 style=\"font-size:clamp(2.5rem, 5vw, 4rem);margin-top:1.5rem;color:var(--text-color);font-family:var(--font-serif)\">Why Linguaplanet?</h2></div><div class=\"grid-responsive\" style=\"gap:2.5rem\"><div class=\"card-premium\" style=\"border-top:4px solid var(--accent-gold)\" data-aos=\"fade-up\" data-aos-delay=\"0\"><div style=\"width:60px;height:60px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:2rem\"><i class=\"fa-solid fa-gem\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.6rem;margin-bottom:1.5rem;color:var(--text-color)\">Quality</h3><ul style=\"list-style:none;padding:0;display:grid;gap:1rem\"><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Ground-breaking and top-notch approaches to teaching and learning.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Universal standards of assessment and testing.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Quick results.</li></ul></div><div class=\"card-premium\" style=\"border-top:4px solid var(--accent-gold)\" data-aos=\"fade-up\" data-aos-delay=\"50\"><div style=\"width:60px;height:60px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:2rem\"><i class=\"fa-solid fa-clock-rotate-left\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.6rem;margin-bottom:1.5rem;color:var(--text-color)\">Flexibility</h3><ul style=\"list-style:none;padding:0;display:grid;gap:1rem\"><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Flexibility in the methods of delivery (F2F/Online) (Our own premises / The Clients).</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Dates/Timing/Scheduling.</li></ul></div><div class=\"card-premium\" style=\"border-top:4px solid var(--accent-gold)\" data-aos=\"fade-up\" data-aos-delay=\"100\"><div style=\"width:60px;height:60px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:2rem\"><i class=\"fa-solid fa-wallet\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.6rem;margin-bottom:1.5rem;color:var(--text-color)\">Pricing</h3><ul style=\"list-style:none;padding:0;display:grid;gap:1rem\"><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Variety of plans to suit your needs.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Very competitive pricing plans.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Variety of payment options.</li></ul></div><div class=\"card-premium\" style=\"border-top:4px solid var(--accent-gold)\" data-aos=\"fade-up\" data-aos-delay=\"150\"><div style=\"width:60px;height:60px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:2rem\"><i class=\"fa-solid fa-chart-line\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.6rem;margin-bottom:1.5rem;color:var(--text-color)\">Reporting and Follow up</h3><ul style=\"list-style:none;padding:0;display:grid;gap:1rem\"><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Get a detailed account of each group/student&#x27;s performance.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Immediate notification of student&#x27;s punctuality.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Tracking student&#x27;s progress.</li></ul></div><div class=\"card-premium\" style=\"border-top:4px solid var(--accent-gold)\" data-aos=\"fade-up\" data-aos-delay=\"200\"><div style=\"width:60px;height:60px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:2rem\"><i class=\"fa-solid fa-shield-halved\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.6rem;margin-bottom:1.5rem;color:var(--text-color)\">Guarantees</h3><ul style=\"list-style:none;padding:0;display:grid;gap:1rem\"><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Extra support for weak students.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Free review classes for failing students.</li><li style=\"display:flex;gap:1rem;opacity:0.7;font-size:0.95rem;line-height:1.4\"><i class=\"fa-solid fa-circle-check\" style=\"color:var(--accent-gold);margin-top:3px\"></i>Openness to feedback and readiness to change and adaptability.</li></ul></div></div></div></section><section style=\"padding:8rem 0;background:var(--bg-color-alt)\"><div class=\"container\"><div class=\"grid-responsive\" style=\"gap:3rem\"><div class=\"glass\" style=\"padding:4.5rem;border-radius:40px;border-left:8px solid var(--accent-gold);border-right:none\" data-aos=\"fade-right\"><div class=\"flex items-center gap-4 mb-6\"><div style=\"width:50px;height:50px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center\"><i class=\"fa-solid fa-triangle-exclamation\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.8rem;color:var(--text-color)\">Facing Challenges?</h3></div><ul style=\"list-style:none;padding:0;display:grid;gap:1.2rem;opacity:0.7;line-height:1.7\"><li><i class=\"fa-solid fa-chevron-right\" style=\"margin-right:1rem;color:var(--accent-gold);font-size:0.8rem;transform:none\"></i> <!-- -->Many candidates have great potential and they are one step away from getting approvals.</li><li><i class=\"fa-solid fa-chevron-right\" style=\"margin-right:1rem;color:var(--accent-gold);font-size:0.8rem;transform:none\"></i> <!-- -->Unfortunately, they are short of the English requirement.</li><li><i class=\"fa-solid fa-chevron-right\" style=\"margin-right:1rem;color:var(--accent-gold);font-size:0.8rem;transform:none\"></i> <!-- -->Even those who could get into other programmes were hindered by their poor language abilities.</li></ul></div><div class=\"glass\" style=\"padding:4.5rem;border-radius:40px;border-left:8px solid var(--accent-gold);border-right:none\" data-aos=\"fade-left\"><div class=\"flex items-center gap-4 mb-6\"><div style=\"width:50px;height:50px;background:rgba(197, 160, 89, 0.1);border-radius:15px;display:flex;align-items:center;justify-content:center\"><i class=\"fa-solid fa-hands-holding\" style=\"color:var(--accent-gold);font-size:1.5rem\"></i></div><h3 style=\"font-size:1.8rem;color:var(--text-color)\">You&#x27;re in Safe Hands</h3></div><p style=\"opacity:0.7;line-height:1.8;margin-bottom:2rem\">In their journey of learning English, they often stumble either due to the lack of financial resources or falling victim to low-quality language-service providers.</p><p style=\"opacity:0.7;line-height:1.8;margin-bottom:2rem\">Thanks to Linguaplanet, this dilemma has ceased to exist.</p><p style=\"opacity:0.9;font-weight:700;color:var(--text-color);line-height:1.8;margin-bottom:2.5rem\">We provide excellent services at a fraction of the price.</p></div></div></div></section><section id=\"services\" style=\"padding:10rem 0;background:var(--bg-color-alt)\"><div class=\"container\"><div class=\"text-center\" style=\"margin-bottom:6rem\"><span style=\"color:var(--accent-gold);font-size:0.8rem;font-weight:800;letter-spacing:4px\">ACADEMIC TRACKS</span><h2 style=\"font-size:3.5rem;margin-top:1rem;color:var(--text-color)\">Our Programs</h2></div><div class=\"grid-responsive\" style=\"gap:2.5rem\"><div class=\"card-premium\" data-aos=\"fade-up\" data-aos-delay=\"0\" style=\"background:var(--card-bg);padding:3rem;border-radius:32px;border:1px solid var(--border-color);transition:all 0.4s ease\"><div style=\"font-size:2.5rem;color:var(--accent-gold);margin-bottom:1.5rem\"><i class=\"fa-solid fa-book-open\"></i></div><h3 style=\"font-size:1.8rem;margin-bottom:1rem;color:var(--text-color)\">General English</h3><p style=\"color:var(--text-color-muted);line-height:1.7\">Structured courses from A1 to C2 covering all core language skills with modern materials.</p><a style=\"display:inline-block;margin-top:2rem;color:var(--accent-gold);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-decoration:none\" href=\"#contact\">EXPLORE TRACK<!-- --> <i class=\"fa-solid fa-arrow-right\" style=\"margin-left:0.5rem\"></i></a></div><div class=\"card-premium\" data-aos=\"fade-up\" data-aos-delay=\"50\" style=\"background:var(--card-bg);padding:3rem;border-radius:32px;border:1px solid var(--border-color);transition:all 0.4s ease\"><div style=\"font-size:2.5rem;color:var(--accent-gold);margin-bottom:1.5rem\"><i class=\"fa-solid fa-comments\"></i></div><h3 style=\"font-size:1.8rem;margin-bottom:1rem;color:var(--text-color)\">Conversation Classes</h3><p style=\"color:var(--text-color-muted);line-height:1.7\">Build real-world fluency fast with small groups and immersive speaking exercises.</p><a style=\"display:inline-block;margin-top:2rem;color:var(--accent-gold);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-decoration:none\" href=\"#contact\">EXPLORE TRACK<!-- --> <i class=\"fa-solid fa-arrow-right\" style=\"margin-left:0.5rem\"></i></a></div><div class=\"card-premium\" data-aos=\"fade-up\" data-aos-delay=\"100\" style=\"background:var(--card-bg);padding:3rem;border-radius:32px;border:1px solid var(--border-color);transition:all 0.4s ease\"><div style=\"font-size:2.5rem;color:var(--accent-gold);margin-bottom:1.5rem\"><i class=\"fa-solid fa-briefcase\"></i></div><h3 style=\"font-size:1.8rem;margin-bottom:1rem;color:var(--text-color)\">Business English</h3><p style=\"color:var(--text-color-muted);line-height:1.7\">Master professional communication for emails, presentations, and global negotiations.</p><a style=\"display:inline-block;margin-top:2rem;color:var(--accent-gold);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-decoration:none\" href=\"#contact\">EXPLORE TRACK<!-- --> <i class=\"fa-solid fa-arrow-right\" style=\"margin-left:0.5rem\"></i></a></div><div class=\"card-premium\" data-aos=\"fade-up\" data-aos-delay=\"150\" style=\"background:var(--card-bg);padding:3rem;border-radius:32px;border:1px solid var(--border-color);transition:all 0.4s ease\"><div style=\"font-size:2.5rem;color:var(--accent-gold);margin-bottom:1.5rem\"><i class=\"fa-solid fa-graduation-cap\"></i></div><h3 style=\"font-size:1.8rem;margin-bottom:1rem;color:var(--text-color)\">IG / SAT Prep</h3><p style=\"color:var(--text-color-muted);line-height:1.7\">Expert coaching and proven strategies to excel in international academic exams.</p><a style=\"display:inline-block;margin-top:2rem;color:var(--accent-gold);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-decoration:none\" href=\"#contact\">EXPLORE TRACK<!-- --> <i class=\"fa-solid fa-arrow-right\" style=\"margin-left:0.5rem\"></i></a></div><div class=\"card-premium\" data-aos=\"fade-up\" data-aos-delay=\"200\" style=\"background:var(--card-bg);padding:3rem;border-radius:32px;border:1px solid var(--border-color);transition:all 0.4s ease\"><div style=\"font-size:2.5rem;color:var(--accent-gold);margin-bottom:1.5rem\"><i class=\"fa-solid fa-certificate\"></i></div><h3 style=\"font-size:1.8rem;margin-bottom:1rem;color:var(--text-color)\">IELTS / TOEFL</h3><p style=\"color:var(--text-color-muted);line-height:1.7\">Achieve your target score with comprehensive prep, mock tests, and expert feedback.</p><a style=\"display:inline-block;margin-top:2rem;color:var(--accent-gold);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-decoration:none\" href=\"#contact\">EXPLORE TRACK<!-- --> <i class=\"fa-solid fa-arrow-right\" style=\"margin-left:0.5rem\"></i></a></div><div class=\"card-premium\" data-aos=\"fade-up\" data-aos-delay=\"250\" style=\"background:var(--card-bg);padding:3rem;border-radius:32px;border:1px solid var(--border-color);transition:all 0.4s ease\"><div style=\"font-size:2.5rem;color:var(--accent-gold);margin-bottom:1.5rem\"><i class=\"fa-solid fa-lightbulb\"></i></div><h3 style=\"font-size:1.8rem;margin-bottom:1rem;color:var(--text-color)\">Soft Skills</h3><p style=\"color:var(--text-color-muted);line-height:1.7\">Leadership, critical thinking, and public speaking — the skills that set you apart.</p><a style=\"display:inline-block;margin-top:2rem;color:var(--accent-gold);font-weight:800;font-size:0.8rem;letter-spacing:1px;text-decoration:none\" href=\"#contact\">EXPLORE TRACK<!-- --> <i class=\"fa-solid fa-arrow-right\" style=\"margin-left:0.5rem\"></i></a></div></div></div></section><section id=\"team\" style=\"padding:8rem 0;backgro